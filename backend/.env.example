# Copy these into your hosting environment (or export them before `npm start`)
PORT=6000
ADMIN_KEY=choose-a-long-random-secret
# Comma separated list of allowed frontend origins. Leave empty to allow all (development only).
CORS_ORIGIN=

# Online payments (Google Pay, PhonePe, any UPI app) via Razorpay: https://dashboard.razorpay.com
# Leave empty to run in DEMO mode (simulated payments, no real money).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://your-domain/api/payments/webhook, events payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# Not-responding rules
CONFIRM_MINUTES=20      # COD order is auto-cancelled if the customer does not confirm in this time
PAY_MINUTES=15          # online order is auto-cancelled if payment is not completed in this time
NO_RESPONSE_LIMIT=2     # after this many no-response cancellations, that phone number cannot use COD
